{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2022",
		"allowJs": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"useUnknownInCatchVariables": true,
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"lib": [
			"DOM",
			"ES2022"
		],
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx"
	],
	"exclude": [
		"src/langr/**"
	]
}
